# ============================================
# 访问控制（部署到公网时建议修改）
# ============================================

# 进入游戏前的访问密码
APP_PASSWORD=1123

# ============================================
# OpenAI API 配置（必填）
# ============================================
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=mimo-v2.5-pro

# 便宜模型（KP 后 Settlement Router、TimeSync、行动建议、场景地图等）
# 与主模型共用 OPENAI_BASE_URL，仅 model 名不同
OPENAI_MODEL_LITE=mimo-v2.5

# 可选：兼容 OpenAI 格式的第三方 API 端点（不填则默认 OpenAI 官方）
# OpenAI 官方：https://api.openai.com/v1
# 小米 MiMo 按量付费：https://api.xiaomimimo.com/v1  （Key 格式 sk-xxx）
# 小米 MiMo Token Plan：https://token-plan-cn.xiaomimimo.com/v1  （Key 格式 tp-xxx）
OPENAI_BASE_URL=https://api.xiaomimimo.com/v1

# KP 叙事温度（0.0–1.0，越高越有创意，默认 0.8）
LLM_TEMPERATURE=0.8

# MiMo 深度思考：false 关闭（默认，响应更快）；true 开启
LLM_THINKING_ENABLED=false

# LLM 请求重试（连接失败 / 超时 / 限流；LangChain Runnable.with_retry）
LLM_RETRY_ENABLED=true
LLM_MAX_RETRIES=3
LLM_RETRY_INITIAL_DELAY=1.0
LLM_RETRY_MAX_DELAY=60.0
LLM_RETRY_BACKOFF_FACTOR=2.0

# ============================================
# 记忆配置（长局优化，适合 3–8+ 小时）
# ============================================

# 短期记忆：保留最近 N 条聊天消息（约 N/2 轮对话）
MAX_HISTORY_MESSAGES=40

# 每 N 回合自动合并摘要并提取关键事实
SUMMARY_INTERVAL=6

# 每 N 回合生成一章章节回顾
CHAPTER_INTERVAL=24

# 剧情总摘要最大字数，超出后自动压缩
MAX_STORY_SUMMARY_CHARS=1500

# 关键事实库最大条数（人名、物品、承诺、线索等）
MAX_MEMORY_FACTS=50

# 关键记忆条数或总字数达到阈值时，按主题 LLM 合并压缩（置顶条目不参与）
MEMORY_JOURNAL_COMPRESS_AT=40
MEMORY_JOURNAL_MAX_CHARS=6000

# 保留最近 N 章章节摘要，更早的并入总摘要
MAX_CHAPTERS_KEPT=8

# ============================================
# 体验优化
# ============================================

# KP 叙事流式输出（逐字显示）
ENABLE_STREAMING=true

# 每轮自动生成 3 个行动建议按钮
ENABLE_ACTION_SUGGESTIONS=true

# 场景图生成（Seedream / DALL·E）
ENABLE_SCENE_IMAGES=false

# 角色立绘（创角时自动生成，可在角色库手动刷新）
ENABLE_CHARACTER_PORTRAITS=true

# 图片提供商：seedream（字节 Seedream / 火山方舟）| openai（DALL·E 3）
IMAGE_PROVIDER=seedream

# Seedream（火山方舟 Ark）— 在控制台创建 API Key 并开通 Seedream 模型
# 文档：https://www.volcengine.com/docs/82379
SEEDREAM_API_KEY=your-ark-api-key-here
SEEDREAM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 模型 ID 或推理接入点 ID（ep-xxx）；常用：doubao-seedream-4-5-251128
SEEDREAM_MODEL=doubao-seedream-4-5-251128
# 尺寸：2K / 4K，或具体像素如 2048x2048（视模型支持）
SEEDREAM_SIZE=2K
# 是否添加 AI 水印
SEEDREAM_WATERMARK=false
